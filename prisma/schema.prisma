generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int      // Price in DOP
  duration    Int      // Duration in minutes
  category    String   @default("general")
  image       String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  appointments AppointmentService[]
}

model Appointment {
  id             String   @id @default(cuid())
  customerName   String
  customerPhone  String
  customerEmail  String
  date           String   // YYYY-MM-DD format
  time           String   // HH:mm format
  numberOfPeople Int      @default(1)
  totalPrice     Int      // Total price in DOP
  totalDuration  Int      // Total duration in minutes
  status         String   @default("pending") // pending, confirmed, completed, cancelled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  services       AppointmentService[]
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  serviceId     String
  price         Int         // Price at time of booking
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, serviceId])
}

model AdminSettings {
  id        String   @id @default("admin")
  password  String   // Hashed password
  email     String   // Admin email for password recovery
  phone     String   // Admin phone for WhatsApp recovery
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
